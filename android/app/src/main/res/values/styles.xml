<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar.Fullscreen">
        <!-- Use the whole display, cutout included. With the default cutout
             mode Android letterboxes a landscape game away from the camera
             hole: on a 2400x1080 screen the window came up 2285x1080 and the
             compositor filled the missing 115 px with black, which is the
             vertical band down the left edge of every video scene. It also
             forced the game to render 1920x1080 and be stretched to 2285,
             which is where the jaggies came from. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Launcher: same black as the screen's gradient, so there is no white
         flash between the icon tap and the first frame. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_bg</item>
        <item name="android:statusBarColor">@color/launcher_bg</item>
        <item name="android:navigationBarColor">@color/launcher_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
